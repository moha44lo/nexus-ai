{
  "name": "nexus-ai",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute nexus --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute nexus --remote --file=./schema.sql",
    "check": "node --check src/index.js && node --check src/nexus-workflow.js && node --check src/skill-engine.js && node --check src/agent-runtime.js && node --check src/mcp-server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
