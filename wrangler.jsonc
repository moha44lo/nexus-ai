{
  "name": "nexus-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-memory",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "workflows": [
    {
      "name": "nexus-core",
      "binding": "NEXUS_CORE",
      "class_name": "NEXUSWorkflow"
    }
  ]
}
